{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "/js/*": ["./js/*"] }
  },
  "include": ["globals.d.ts", "js/**/*.js", "tests/**/*.js"]
}
